<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Cards.uss" />
    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="topBar" class="top-bar" picking-mode="Ignore">
            <ui:Label name="title" text="Tl UI Cards" class="title" />
            <ui:VisualElement name="energy" class="stat energy" picking-mode="Ignore">
                <ui:Label text="Energy" class="stat-caption" />
                <ui:Label name="energyValue" class="stat-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Energy" binding-mode="ToTarget" source-to-ui-converters="tl-integer" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement class="stat" picking-mode="Ignore">
                <ui:Label text="Score" class="stat-caption" />
                <ui:Label name="scoreValue" class="stat-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Score" binding-mode="ToTarget" source-to-ui-converters="tl-integer" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement class="stat" picking-mode="Ignore">
                <ui:Label text="Deck" class="stat-caption" />
                <ui:Label name="deckValue" class="stat-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CardsInDeck" binding-mode="ToTarget" source-to-ui-converters="tl-integer" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="table" class="table">
            <ui:Label text="Drag a card here to play it" class="table-hint" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="hand" class="hand" />
        <ui:VisualElement class="buttons" picking-mode="Ignore">
            <ui:Button name="draw" text="Draw a card" class="button" />
            <ui:Button name="endTurn" text="End turn" class="button" />
        </ui:VisualElement>
        <ui:Label name="banner" text="Your turn" class="banner start-hidden" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
