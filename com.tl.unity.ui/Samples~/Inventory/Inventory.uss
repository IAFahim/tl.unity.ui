.screen {
    flex-grow: 1;
    padding: 28px;
}

.nameplates {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.title {
    margin-bottom: 14px;
    font-size: 34px;
    color: rgb(240, 242, 248);
}

.start-hidden {
    display: none;
}

.columns {
    flex-direction: row;
    align-items: flex-start;
}

.column {
    margin-right: 28px;
    width: 380px;
}

.heading {
    margin-bottom: 8px;
    font-size: 18px;
    color: rgb(170, 180, 200);
}

.bag {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 110px;
    height: 80px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 6px;
    justify-content: space-between;
    background-color: rgba(18, 22, 30, 0.9);
    border-width: 2px;
    border-color: rgb(78, 88, 108);
    border-radius: 8px;
}

.tl-dragging .slot {
    opacity: 0.5;
}

.tl-drop-target .slot {
    border-color: rgb(255, 196, 64);
}

:hover > .slot {
    background-color: rgba(34, 40, 54, 0.95);
}

:focus > .slot {
    border-color: rgb(120, 190, 255);
}

.slot-name {
    font-size: 16px;
    color: rgb(235, 238, 245);
}

.slot-count {
    align-self: flex-end;
    font-size: 20px;
    color: rgb(170, 220, 255);
}

.shop {
    height: 240px;
    background-color: rgba(18, 22, 30, 0.9);
    border-radius: 8px;
}

.shop-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 40px;
    padding: 0 12px;
}

.shop-name {
    font-size: 18px;
    color: rgb(235, 238, 245);
}

.shop-price {
    font-size: 18px;
    color: rgb(255, 196, 64);
}

.nameplate {
    translate: -50% -100%;
    padding: 2px 8px;
    background-color: rgba(18, 22, 30, 0.8);
    border-radius: 6px;
    align-items: center;
}

.nameplate-name {
    font-size: 14px;
    color: rgb(240, 242, 248);
}

.nameplate-health {
    font-size: 12px;
    color: rgb(255, 120, 120);
}
