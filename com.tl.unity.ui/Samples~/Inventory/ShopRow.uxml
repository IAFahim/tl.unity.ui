<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Inventory.uss" />
    <ui:VisualElement name="shopRow" class="shop-row">
        <ui:Label name="shopName" class="shop-name">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="DisplayName" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
        <ui:Label name="shopPrice" class="shop-price">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="Price" binding-mode="ToTarget" source-to-ui-converters="tl-integer" />
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
