.screen {
    flex-grow: 1;
    align-items: flex-start;
    padding: 32px;
}

.title {
    margin-bottom: 16px;
    font-size: 36px;
    color: rgb(240, 242, 248);
}

.start-hidden {
    display: none;
}

.card {
    margin-bottom: 12px;
    padding: 12px 16px;
    min-width: 360px;
    background-color: rgba(18, 22, 30, 0.9);
    border-width: 2px;
    border-color: rgb(78, 88, 108);
    border-radius: 8px;
    color: rgb(225, 230, 240);
    font-size: 20px;
}

.glows {
    transition-duration: 0.25s;
}

.is-glowing {
    border-color: rgb(255, 196, 64);
}

.go {
    margin-bottom: 12px;
    min-width: 200px;
    height: 48px;
    font-size: 22px;
}

.caption {
    margin-top: 8px;
    min-height: 32px;
    font-size: 22px;
    color: rgb(170, 220, 255);
}

.progress {
    min-width: 360px;
}

.badge {
    margin-top: 8px;
    padding: 4px 10px;
    align-self: flex-start;
    background-color: rgb(255, 196, 64);
    border-radius: 12px;
    color: rgb(30, 24, 8);
    font-size: 16px;
}
