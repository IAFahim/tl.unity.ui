<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud">
        <ui:Label name="title" text="Tl UI HUD" class="title start-hidden" />
        <ui:Label name="lowHealth" text="Low health" class="banner">
            <Bindings>
                <ui:DataBinding property="style.display" data-source-path="LowHealth" binding-mode="ToTarget" source-to-ui-converters="tl-visible" />
            </Bindings>
        </ui:Label>
        <ui:Label name="flashBanner" text="Flash timeline" class="banner flash start-hidden" />
        <ui:VisualElement class="row">
            <ui:Label text="Health" class="caption" />
            <ui:Label name="health" class="value">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Health" binding-mode="ToTarget" source-to-ui-converters="tl-integer" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:ProgressBar name="healthBar" low-value="0" high-value="1" class="health-bar">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="HealthFraction" binding-mode="ToTarget" />
            </Bindings>
        </ui:ProgressBar>
        <ui:VisualElement class="row">
            <ui:Label text="Coins" class="caption" />
            <ui:Label name="coins" class="value">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Coins" binding-mode="ToTarget" source-to-ui-converters="tl-integer" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement class="row">
            <ui:Label text="Time" class="caption" />
            <ui:Label name="clock" class="value">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Seconds" binding-mode="ToTarget" source-to-ui-converters="tl-clock" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement class="row">
            <ui:Button name="heal" text="Heal" class="button" />
            <ui:Button name="flash" text="Flash" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
